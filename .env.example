# Copy to backend/.env to override. All variables are optional.
TRUTHLENS_MAX_UPLOAD_MB=15
TRUTHLENS_MAX_PIXELS=40000000
TRUTHLENS_DEVICE=auto            # auto | cpu | cuda
TRUTHLENS_ENABLE_SALIENCY=true   # occlusion maps (64 extra forward passes; ~1-3 s on GPU, slower on CPU)
TRUTHLENS_OFFLINE=true           # never contact Hugging Face at runtime
TRUTHLENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AI detectors to load (SwinV2 + the Community Forensics family). "swinv2_ai_detector" alone reproduces the old setup.
TRUTHLENS_DETECTORS=swinv2_ai_detector,cf_frontier,cf_lowq
# Quality gate: below these the app never claims "No AI detected" (detectors miss more AI images there).
TRUTHLENS_LOW_QUALITY_LONG_SIDE=512
TRUTHLENS_LOW_QUALITY_JPEG=75
# TRUTHLENS_DATA_DIR=./data
# TRUTHLENS_MODELS_DIR=./models_cache
# TRUTHLENS_DATABASE_URL=sqlite:///./data/truthlens.db
